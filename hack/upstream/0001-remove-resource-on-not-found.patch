diff --git a/internal/provider/not_found.go b/internal/provider/not_found.go
new file mode 100644
index 0000000..21560f0
--- /dev/null
+++ b/internal/provider/not_found.go
@@ -0,0 +1,33 @@
+package provider
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/vektah/gqlparser/v2/gqlerror"
+)
+
+// isNotFoundError reports whether err is a Railway GraphQL response error
+// stating that the requested object does not exist (e.g. "Project not found").
+//
+// Only GraphQL response errors are considered, so internal sentinel errors such
+// as "deploy is not found" (partial data on an object that does exist) are not
+// mistaken for a deleted resource. Read implementations use this to remove the
+// resource from state, which is how Terraform expects out-of-band deletion to
+// be signalled (and what tooling such as Crossplane/Upjet relies on).
+func isNotFoundError(err error) bool {
+	var list gqlerror.List
+	if errors.As(err, &list) {
+		for _, e := range list {
+			if e != nil && strings.Contains(strings.ToLower(e.Message), "not found") {
+				return true
+			}
+		}
+		return false
+	}
+	var single *gqlerror.Error
+	if errors.As(err, &single) {
+		return strings.Contains(strings.ToLower(single.Message), "not found")
+	}
+	return false
+}
diff --git a/internal/provider/resource_project.go b/internal/provider/resource_project.go
index 8cbe167..3c85e56 100644
--- a/internal/provider/resource_project.go
+++ b/internal/provider/resource_project.go
@@ -244,6 +244,11 @@ func (r *ProjectResource) Read(ctx context.Context, req resource.ReadRequest, re
 	project, enviroment, err := defaultEnvironmentForProject(ctx, *r.client, data.Id.ValueString())
 
 	if err != nil {
+		if isNotFoundError(err) {
+			resp.State.RemoveResource(ctx)
+			return
+		}
+
 		resp.Diagnostics.AddError("Client Error", fmt.Sprintf("Unable to read project, got error: %s", err))
 		return
 	}
