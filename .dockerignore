# Keep the build context to the git tree. .work in particular holds native-cluster
# binaries and etcd data (hundreds of MB) that would otherwise be shipped to the
# builder on every local `docker build`.
.work/
_output/
.cache/
.git/
vendor/
.vendor-new/
cover.out
.vscode/
.idea/
.DS_Store

# Never ship credentials or local config to a builder
kubeconfig-external*
*.kubeconfig
*.key
*.pem
.env
.env.*
.claude/
